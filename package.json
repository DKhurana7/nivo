{
  "name": "nivo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "user:create": "node --env-file-if-exists=.env --import tsx server/create-user.ts",
    "test:server": "node --import tsx --test server/tests/*.test.ts",
    "check:server": "tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@fontsource-variable/manrope": "^5.2.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.2",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "motion": "^12.0.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=22.22"
  }
}

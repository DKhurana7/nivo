# Copy via: node scripts/configure-local.mjs (generates secrets; never overwrites .env).
APP_ORIGIN=http://127.0.0.1:5178
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/nivo.sqlite
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_CALLBACK_SECRET=
AGENT_HEALTH_URL=http://127.0.0.1:8081/
NIVO_API_URL=http://127.0.0.1:8787
ENABLE_OUTBOUND_CALLS=false
LIVEKIT_SIP_TRUNK_ID=
SIP_TRANSPORT=auto
CALL_MAX_SECONDS=300
STT_PROVIDER=local
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:4b-instruct
LLM_API_KEY=local
TTS_PROVIDER=local
PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx
AGENT_LANGUAGE=English
DPDFNET_ENABLED=false
DPDFNET_MODEL=dpdfnet2
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH=0.15
VAD_MIN_SILENCE=0.5
VAD_PREFIX_PADDING=0.3
ENDPOINT_MIN_SECONDS=0.5
ENDPOINT_MAX_SECONDS=3
INTERRUPTION_SECONDS=0.5
AGENT_SPOOL_DIR=./data/agent-spool
EXTRACTION_BASE_URL=http://127.0.0.1:11434/v1
EXTRACTION_MODEL=qwen3:4b-instruct
EXTRACTION_API_KEY=local
# Optional credit-funded/cloud providers. Never needed for the local profile.
# Set STT_PROVIDER=deepgram and optionally TTS_PROVIDER=deepgram to use your credits.
# Configure the private .env locally; never put keys into VITE_* or commit them.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en
STT_LANGUAGE=multi
ELEVEN_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Production only:
# NODE_ENV=production
# APP_DOMAIN=nivo.your-domain.example
# LIVEKIT_DOMAIN=voice.your-domain.example
# SIP_IMAGE=livekit/sip@sha256:<verified digest>
